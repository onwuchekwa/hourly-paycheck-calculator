rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model — prototype rules; review before production
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (userDoc().data.role == 'admin' || userDoc().data.role == 'employer');
    }

    function isEmployee() {
      return isSignedIn() && userDoc().data.role == 'employee';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validEditReason(reason) {
      return reason is string && reason.size() >= 10;
    }

    function isOwnTimeEntryId(entryId) {
      return entryId.matches('^' + request.auth.uid + '_.+');
    }

    function isOwnPaySlipId(slipId) {
      return slipId.matches('^.+_' + request.auth.uid + '$');
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if false;
      allow update: if isAdmin() || (
        isOwner(userId) &&
        isEmployee() &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']) &&
            resource.data.mustChangePassword == true &&
            request.resource.data.mustChangePassword == false
          )
        )
      );
      allow delete: if false;
    }

    function validRejectionReason() {
      return request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() > 0;
    }

    function adminReviewUpdate() {
      return isAdmin()
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvedAt',
          'rejectedAt',
          'rejectionReason',
          'reviewedAt',
          'reviewedBy',
          'updatedAt',
        ])
        && (
          request.resource.data.status == 'approved'
          || (request.resource.data.status == 'rejected' && validRejectionReason())
        );
    }

    match /timeEntries/{entryId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isEmployee() && (
          isOwnTimeEntryId(entryId) ||
          resource.data.employeeId == request.auth.uid
        ))
      );
      allow create: if isSignedIn() && (
        isEmployee() && request.resource.data.employeeId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        adminReviewUpdate() ||
        (
          isEmployee() &&
          resource.data.employeeId == request.auth.uid &&
          resource.data.status in ['draft', 'submitted', 'rejected']
        )
      );
      allow delete: if (
        isEmployee() &&
        resource.data.employeeId == request.auth.uid &&
        resource.data.status in ['draft', 'submitted', 'rejected']
      );
    }

    match /employeeRates/{rateId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /payPeriods/{periodId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payrollRuns/{runId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /paySlips/{slipId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isEmployee() && (
          isOwnPaySlipId(slipId) ||
          resource.data.employeeId == request.auth.uid
        ))
      );
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
