rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Deactivated accounts keep Firebase Auth access until removed, so rules
    // must deny them. Older docs without an `active` field are treated as active.
    function isActiveUser() {
      return userDoc().data.get('active', true) != false;
    }

    function isAdmin() {
      return isSignedIn()
        && (userDoc().data.role == 'admin' || userDoc().data.role == 'employer')
        && isActiveUser();
    }

    function isEmployee() {
      return isSignedIn()
        && userDoc().data.role == 'employee'
        && isActiveUser();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validEditReason(reason) {
      return reason is string && reason.size() >= 10 && reason.size() <= 500;
    }

    function validPunchesList(punches) {
      return punches is list && punches.size() <= 20;
    }

    // Midnight UTC of a 'YYYY-MM-DD' work date.
    function workDateStart(workDate) {
      return timestamp.date(
        int(workDate[0:4]),
        int(workDate[5:7]),
        int(workDate[8:10])
      );
    }

    // A punch must be a well-formed interval landing near its work date.
    // `clockOut` is null while the punch is still open. The window is padded a
    // day either side because punch timestamps are stored in the employee's
    // local time while the work date boundary here is UTC.
    function validPunch(punch, workDate) {
      return punch is map
        && punch.keys().hasOnly(['clockIn', 'clockOut'])
        && punch.get('clockIn', null) is timestamp
        && punch.clockIn >= workDateStart(workDate) - duration.value(1, 'd')
        && punch.clockIn < workDateStart(workDate) + duration.value(2, 'd')
        && (
          punch.get('clockOut', null) == null
          || (
            punch.clockOut is timestamp
            && punch.clockOut >= punch.clockIn
            && punch.clockOut <= punch.clockIn + duration.value(24, 'h')
          )
        );
    }

    // The rules language has no loops, so each slot is checked explicitly up to
    // the 20-punch cap enforced by validPunchesList.
    function validPunchesContent(punches, workDate) {
      return validPunchesList(punches)
        && (punches.size() < 1 || validPunch(punches[0], workDate))
        && (punches.size() < 2 || validPunch(punches[1], workDate))
        && (punches.size() < 3 || validPunch(punches[2], workDate))
        && (punches.size() < 4 || validPunch(punches[3], workDate))
        && (punches.size() < 5 || validPunch(punches[4], workDate))
        && (punches.size() < 6 || validPunch(punches[5], workDate))
        && (punches.size() < 7 || validPunch(punches[6], workDate))
        && (punches.size() < 8 || validPunch(punches[7], workDate))
        && (punches.size() < 9 || validPunch(punches[8], workDate))
        && (punches.size() < 10 || validPunch(punches[9], workDate))
        && (punches.size() < 11 || validPunch(punches[10], workDate))
        && (punches.size() < 12 || validPunch(punches[11], workDate))
        && (punches.size() < 13 || validPunch(punches[12], workDate))
        && (punches.size() < 14 || validPunch(punches[13], workDate))
        && (punches.size() < 15 || validPunch(punches[14], workDate))
        && (punches.size() < 16 || validPunch(punches[15], workDate))
        && (punches.size() < 17 || validPunch(punches[16], workDate))
        && (punches.size() < 18 || validPunch(punches[17], workDate))
        && (punches.size() < 19 || validPunch(punches[18], workDate))
        && (punches.size() < 20 || validPunch(punches[19], workDate));
    }

    function validOfflineSyncMeta() {
      return !request.resource.data.keys().hasAny(['offlineSyncMeta'])
        || (
          request.resource.data.offlineSyncMeta is map
          && request.resource.data.offlineSyncMeta.keys().hasOnly(['deviceId', 'syncedAt', 'appVersion', 'localRevision'])
          && request.resource.data.offlineSyncMeta.deviceId is string
          && request.resource.data.offlineSyncMeta.deviceId.size() <= 64
        );
    }

    function validPunchSource() {
      return !request.resource.data.keys().hasAny(['punchSource'])
        || request.resource.data.punchSource in ['button', 'manual_edit', 'auto_eod', 'offline_sync'];
    }

    function isOwnTimeEntryId(entryId) {
      return entryId.matches('^' + request.auth.uid + '_.+');
    }

    function isOwnPaySlipId(slipId) {
      return slipId.matches('^.+_' + request.auth.uid + '$');
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if false;
      allow update: if isAdmin() || (
        isOwner(userId) &&
        isEmployee() &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']) &&
            resource.data.mustChangePassword == true &&
            request.resource.data.mustChangePassword == false
          )
        )
      );
      allow delete: if false;
    }

    function validRejectionReason() {
      return request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() > 0;
    }

    function adminReviewUpdate() {
      return isAdmin()
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvedAt',
          'rejectedAt',
          'rejectionReason',
          'reviewedAt',
          'reviewedBy',
          'updatedAt',
        ])
        && (
          request.resource.data.status == 'approved'
          || (request.resource.data.status == 'rejected' && validRejectionReason())
        );
    }

    // Employees may only touch clock/punch data, submission fields, and edit
    // history. Notably absent: employeeId, workDate, employeeName, and any
    // admin review fields (approvedAt, reviewedBy, ...).
    function employeePunchEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'punches',
          'clockIn',
          'clockOut',
          'punchSource',
          'editHistory',
          'status',
          'submittedAt',
          'rejectionReason',
          'rejectedAt',
          'offlineSyncMeta',
          'updatedAt',
        ])
        // Employees can never set 'approved'; 'rejected' only persists if the
        // entry was already rejected (editing punches without a status change).
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status in ['draft', 'submitted']
        )
        && validPunchesContent(request.resource.data.punches, resource.data.workDate)
        && validPunchSource()
        && validOfflineSyncMeta()
        && validEditHistoryChange();
    }

    // Once submitted, the entry is evidence for payroll. The only employee
    // action left is withdrawing it back to draft; punches stay frozen.
    function employeeStatusOnlyChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'submittedAt',
          'offlineSyncMeta',
          'updatedAt',
        ])
        && request.resource.data.status == 'draft'
        && validOfflineSyncMeta();
    }

    function employeeEntryUpdate() {
      return isEmployee()
        && resource.data.employeeId == request.auth.uid
        && (
          (resource.data.status in ['draft', 'rejected'] && employeePunchEdit())
          || (resource.data.status == 'submitted' && employeeStatusOnlyChange())
        );
    }

    // Any change to editHistory must append an entry with a meaningful reason.
    function validEditHistoryChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['editHistory'])
        || (
          request.resource.data.editHistory is list
          && request.resource.data.editHistory.size() > resource.data.get('editHistory', []).size()
          && validEditReason(request.resource.data.editHistory[request.resource.data.editHistory.size() - 1].reason)
        );
    }

    match /timeEntries/{entryId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isEmployee() && (
          isOwnTimeEntryId(entryId) ||
          resource.data.employeeId == request.auth.uid
        ))
      );
      allow create: if isEmployee()
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.workDate is string
        && request.resource.data.workDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        // Doc ID must encode the owner and work date: {uid}_{workDate}.
        && entryId == request.auth.uid + '_' + request.resource.data.workDate
        && validPunchesContent(request.resource.data.punches, request.resource.data.workDate)
        && (
          request.resource.data.keys().hasOnly([
            'employeeId',
            'employeeName',
            'workDate',
            'status',
            'punches',
            'updatedAt',
          ])
          || (
            request.resource.data.keys().hasOnly([
              'employeeId',
              'employeeName',
              'workDate',
              'status',
              'punches',
              'punchSource',
              'offlineSyncMeta',
              'editHistory',
              'submittedAt',
              'updatedAt',
            ])
            && validPunchSource()
            && validOfflineSyncMeta()
          )
        );
      allow update: if adminReviewUpdate() || employeeEntryUpdate();
      // Only drafts may be removed: deleting a submitted or rejected entry
      // would erase the review trail.
      allow delete: if (
        isEmployee() &&
        resource.data.employeeId == request.auth.uid &&
        resource.data.status == 'draft'
      );
    }

    match /employeeRates/{rateId} {
      // Rates are sensitive: admins see all, employees only their own.
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /taxRates/{rateId} {
      allow read: if isSignedIn() && isActiveUser();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['effectiveTo', 'updatedAt']);
      allow delete: if false;
    }

    match /payPeriods/{periodId} {
      allow read: if isAdmin() || isEmployee();
      allow write: if isAdmin();
    }

    match /payrollRuns/{runId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && resource.data.status == 'preview';
    }

    match /paySlips/{slipId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isEmployee() && (
          isOwnPaySlipId(slipId) ||
          resource.data.employeeId == request.auth.uid
        ))
      );
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{docId} {
      // The company doc is intentionally public: login/home pages show
      // company branding before sign-in. Do not store secrets in it. Every
      // other settings doc (payroll config, integrations) is admin-only.
      allow read: if docId == 'company' || isAdmin();
      allow write: if isAdmin();
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
