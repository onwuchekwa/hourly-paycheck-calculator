# Cloud Functions environment (copy to functions/.env for local emulators)
# Production: set via `firebase functions:secrets:set` and deploy params.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_FROM=HourlyPay <noreply@yourcompany.com>
APP_SIGN_IN_URL=http://localhost:5173/login

# Secret — do not commit. For local emulators, create functions/.secret.local:
# SMTP_PASS=your-smtp-password
