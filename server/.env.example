# Copy to server/.env — never commit server/.env

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-username
SMTP_PASS=your-password
SMTP_FROM=HourlyPay <noreply@yourcompany.com>
APP_SIGN_IN_URL=http://localhost:5173/login

# Firebase Admin SDK — paste full service account JSON on one line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# Comma-separated origins allowed by CORS (include local dev + both Firebase Hosting URLs)
ALLOWED_ORIGIN=http://localhost:5173,https://payroll-management-d4f0b.web.app,https://payroll-management-d4f0b.firebaseapp.com

PORT=3001
