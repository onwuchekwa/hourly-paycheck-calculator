{
  "name": "hourly-paycheck-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --prefix server",
    "dev:app": "concurrently -k -n api,vite -c magenta,cyan \"npm run dev:api\" \"vite\"",
    "dev:local": "concurrently -k -n emulators,api,vite -c yellow,magenta,cyan \"npm run emulators\" \"npm run dev:api\" \"vite\"",
    "emulators": "npx firebase-tools@latest emulators:start --export-on-exit=./.firebase-emulator-data",
    "seed:emulator": "node scripts/seedEmulator.mjs",
    "setup:email": "node scripts/configure-smtp.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "npx firebase-tools@latest emulators:exec --only firestore \"vitest run tests/firestore-rules.test.ts\""
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2"
  }
}
